rules_version = '2';

// Reglas de seguridad de Natara (Firestore)
// - La superadmin es samanat2026@gmail.com con el correo verificado.
// - Cada usuario solo ve los datos de su negocio.
// - Un negocio suspendido puede ver sus datos, pero no puede modificarlos.
// - Los cajeros solo escriben lo que sus permisos permiten.
// - Los meseros son empleados (role 'cajero') con puesto 'mesero': la app solo les muestra las mesas.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'samanat2026@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function active() { return hasProfile() && profile().active == true && profile().get('archived', false) != true; }
    function inTenant(tid) { return active() && profile().tid == tid; }
    function isOwnerOf(tid) { return inTenant(tid) && profile().role == 'dueno'; }
    // Activo = no suspendido y sin pasar 3 días de gracia después del vencimiento (259200000 ms)
    function tenantActive(tid) {
      let t = get(/databases/$(database)/documents/tenants/$(tid)).data;
      return t.status == 'activo' && (t.due + 259200000 > request.time.toMillis() || payReported(tid));
    }
    // Si el dueño reportó un pago, la cuenta sigue activa 7 días (604800000 ms) mientras Samanat lo revisa,
    // pero nunca más de 10 días después del vencimiento (3 de gracia + 7 de revisión = 864000000 ms),
    // así reportar el pago varias veces no alarga el acceso.
    function payReported(tid) {
      let path = /databases/$(database)/documents/orders/$('pend_' + tid);
      let t = get(/databases/$(database)/documents/tenants/$(tid)).data;
      return exists(path) && get(path).data.status == 'pendiente'
        && get(path).data.at + 604800000 > request.time.toMillis()
        && t.due + 864000000 > request.time.toMillis();
    }
    function hasPerm(p) { return p in profile().get('perms', []); }
    // Recetas y combos: un cajero con el permiso 'recetas' solo toca productos que tienen receta
    function isRecipe(coll, data) {
      return coll == 'products' && hasPerm('recetas') && data.get('recipe', []).size() > 0;
    }
    // Puntos y fidelización: cualquier usuario del negocio afilia y suma puntos en la caja, si el negocio tiene el módulo
    // El plan Restaurante incluye todos los módulos; Premium (id 'total') todos menos Mesas
    function hasMod(tid, m) {
      let t = get(/databases/$(database)/documents/tenants/$(tid)).data;
      return m in t.get('mods', [])
        || t.get('plan', '') == 'restaurante'
        || (t.get('plan', '') == 'total' && m != 'mesas');
    }
    // Ventas, cajas y kardex: cualquier usuario del negocio los CREA, pero solo el dueño los cambia o borra.
    // Los empleados solo pueden: confirmar una transferencia, anular una venta (con el permiso 'anular')
    // y cerrar una caja que sigue abierta.
    function canCreateLog(coll) { return coll in ['sales', 'sessions', 'kardex']; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function empUpdateLog(coll) {
      return (coll == 'sales' && changed().hasOnly(['confirmed']) && request.resource.data.confirmed == true)
        || (coll == 'sales' && hasPerm('anular') && resource.data.status == 'ok'
            && request.resource.data.status == 'anulada'
            && changed().hasOnly(['status', 'voidBy', 'voidAt', 'voidWhy'])
            && request.resource.data.voidBy == request.auth.uid)
        || (coll == 'sessions' && resource.data.closedAt == null
            && changed().hasOnly(['closedAt', 'closedBy', 'counted', 'expected', 'diff'])
            && request.resource.data.closedBy == request.auth.uid);
    }
    function canWrite(tid, coll) {
      return isOwnerOf(tid)
        || (coll in ['members', 'pmoves'] && hasMod(tid, 'fidelizacion'))
        // Mesas y meseros: cualquier usuario del negocio abre mesas, agrega productos y cobra lo pendiente
        // (las mesas en sí, colección 'tables', solo las crea y renombra el dueño)
        || (coll in ['tabs', 'tablines'] && hasMod(tid, 'mesas'))
        || (coll in ['customers', 'ledger'] && (hasPerm('fiados') || hasPerm('anular')))
        || (coll == 'products' && hasPerm('inv_edit'))
        // Caja por categorías: quien edita el inventario también crea y ordena las categorías
        || (coll == 'cats' && hasPerm('inv_edit'))
        || (coll in ['suppliers', 'purchases'] && hasPerm('proveedores'))
        || (coll == 'moves' && (hasPerm('finanzas') || hasPerm('proveedores')));
    }

    // Configuración general: precios, contacto, EmailJS
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Usuarios (el id del documento es el uid de Firebase Auth)
    match /users/{uid} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == uid)
        || (active() && resource.data.tid == profile().tid);
      allow create: if isAdmin()
        || (isOwnerOf(request.resource.data.tid) && request.resource.data.role == 'cajero');
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChange']))
        || (isOwnerOf(resource.data.tid) && resource.data.role == 'cajero'
            && request.resource.data.role == 'cajero'
            && request.resource.data.tid == resource.data.tid);
      allow delete: if isAdmin();
    }

    // Negocios y sus datos
    match /tenants/{tid} {
      allow read: if isAdmin() || inTenant(tid);
      allow write: if isAdmin();

      match /{coll}/{id} {
        allow read: if isAdmin() || inTenant(tid);
        allow create: if isAdmin()
          || (inTenant(tid) && tenantActive(tid) && request.resource.data.tid == tid
              && (canWrite(tid, coll) || canCreateLog(coll) || isRecipe(coll, request.resource.data))
              // una venta siempre queda a nombre de quien la registra
              && (coll != 'sales' || request.resource.data.seller == request.auth.uid));
        allow update: if isAdmin()
          || (inTenant(tid) && tenantActive(tid) && request.resource.data.tid == tid
              // nadie puede cambiar quién hizo una venta
              && (coll != 'sales' || request.resource.data.seller == resource.data.seller)
              && (canWrite(tid, coll)
                  || (canCreateLog(coll) && empUpdateLog(coll))
                  || (isRecipe(coll, request.resource.data) && isRecipe(coll, resource.data))
                  || (coll == 'products' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']))));
        allow delete: if isAdmin() || (inTenant(tid) && tenantActive(tid) && (canWrite(tid, coll) || isRecipe(coll, resource.data)));
      }
    }

    // Pagos a Samanat
    match /payments/{id} {
      allow read: if isAdmin() || isOwnerOf(resource.data.tid);
      allow write: if isAdmin();
    }

    // Llave Bre-B pública para la demo
    match /public/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pago reportado por el dueño: cuota (pend_<negocio>) o módulo (mod_<negocio>_<módulo>)
    function ownOrder(id, d) {
      // La fecha del reporte es la de ahora (máximo 5 minutos de diferencia con el reloj del servidor)
      return isOwnerOf(d.tid) && d.status == 'pendiente'
        && d.at is int && d.at > request.time.toMillis() - 300000 && d.at < request.time.toMillis() + 300000
        && ((d.type == 'renovacion' && id == 'pend_' + d.tid)
            || (d.type == 'modulo' && id == 'mod_' + d.tid + '_' + d.mod
                && d.mod in ['inventario','caja','finanzas','estadisticas','empleados','fiados','proveedores','mesas','recetas','lector','fidelizacion','implementacion']));
    }

    // Pagos con llave Bre-B: renovaciones (pend_<negocio>) y compras desde la demo
    match /orders/{id} {
      allow read: if isAdmin() || (active() && resource.data.get('tid', '') == profile().tid);
      // Cualquiera puede pedir un plan desde la demo (queda pendiente hasta que Samanat apruebe)
      allow create: if isAdmin()
        || (request.resource.data.type == 'nuevo'
            && request.resource.data.status == 'pendiente'
            && !id.matches('pend_.*')
            && request.resource.data.keys().hasOnly(['id','type','status','at','ref','plan','mods','months','setup','amount','business','btype','city','phone','owner','email','comprobante'])
            && request.resource.data.plan in ['basico','pro','total','restaurante']
            && request.resource.data.months in [1, 12]
            && request.resource.data.amount is number
            && request.resource.data.email is string && request.resource.data.email.size() < 120
            && request.resource.data.business is string && request.resource.data.business.size() < 120
            && request.resource.data.owner is string && request.resource.data.owner.size() < 120
            && request.resource.data.comprobante.size() <= 60)
        || ownOrder(id, request.resource.data);
      allow update: if isAdmin()
        || (ownOrder(id, request.resource.data) && request.resource.data.tid == resource.data.tid);
      allow delete: if isAdmin();
    }

    // Solicitudes de módulos e implementación
    match /requests/{id} {
      allow read: if isAdmin() || isOwnerOf(resource.data.tid);
      allow create: if isAdmin()
        || (isOwnerOf(request.resource.data.tid) && request.resource.data.status == 'pendiente');
      allow update, delete: if isAdmin();
    }

    // Mensajes de Samanat a los clientes
    match /messages/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.to == 'all')
        || (active() && resource.data.to == profile().tid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (active() && (resource.data.to == 'all' || resource.data.to == profile().tid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']));
    }

    // Actividad en vivo
    match /presence/{uid} {
      allow read: if isAdmin();
      allow write: if signedIn() && request.auth.uid == uid;
    }
    match /activity/{id} {
      allow read, delete: if isAdmin();
      allow create: if active()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tid == profile().tid;
    }
    match /stats/{tid} {
      allow read, delete: if isAdmin();
      allow write: if inTenant(tid);
    }
    // Visitas a la demo: cualquiera lee; cada visita solo suma 1 (y máximo 1 persona nueva)
    function visitOk(d) {
      return d.keys().hasOnly(['visitas','personas','ultima'])
        && d.ultima is int && d.ultima <= request.time.toMillis() + 600000;
    }
    match /demovisits/{id} {
      allow read: if true;
      allow create: if (id == 'total' || id.matches('d_[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        && visitOk(request.resource.data)
        && request.resource.data.visitas == 1
        && request.resource.data.personas in [0, 1];
      allow update: if visitOk(request.resource.data)
        && request.resource.data.visitas == resource.data.visitas + 1
        && request.resource.data.personas in [resource.data.personas, resource.data.personas + 1];
      allow delete: if isAdmin();
    }
  }
}
